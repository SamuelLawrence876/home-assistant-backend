{
  "name": "home-assistant-backend",
  "version": "0.1.0",
  "description": "Home Assistant backend — AWS serverless API for managing smart-home devices, built with CDK v2 and TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "bin": {
    "infra": "infrastructure/bin/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --project tsconfig.json --noEmit --skipLibCheck",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "test": "jest --maxWorkers=4",
    "test:update": "npm run test -- -u",
    "test:infra": "jest --config=jest.config.infra.js",
    "test:infra:update": "npm run test:infra -- -u",
    "test:acceptance": "jest --config=jest.config.acceptance.js",
    "synth": "npx cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1051.0",
    "@aws-sdk/lib-dynamodb": "^3.1051.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/aws-lambda": "^8.10.156",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "aws-cdk": "^2.1124.1",
    "aws-cdk-lib": "^2.256.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}
